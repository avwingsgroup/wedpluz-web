# Wedpluz web + admin — security headers (rendered to /etc/nginx/snippets/wedpluz-web-headers.conf).
# Included in every location that sets its own add_header: nginx drops inherited headers there otherwise.

add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
# camera/microphone: QR check-in scanner, identity selfie, voice notes and live sessions. geolocation: events near you.
add_header Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=()" always;
# same-origin-allow-popups keeps Google sign-in popups working.
add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
# {{HSTS_LINE}}

# Report-only first (docs/deployment.md §4.3): watch the browser console / reports, then switch to enforcing.
add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.amazonaws.com https://lh3.googleusercontent.com https://picsum.photos https://i.pravatar.cc; media-src 'self' blob: https://res.cloudinary.com https://*.amazonaws.com; connect-src 'self' {{API_ORIGIN}} wss://{{API_HOST}} https://api.cloudinary.com https://*.amazonaws.com https://*.ingest.sentry.io https://accounts.google.com; frame-src https://accounts.google.com https://www.google.com https://maps.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.paystack.com https://checkout.stripe.com https://www.paypal.com https://sandbox.monnify.com https://checkout.monnify.com; object-src 'none'" always;
