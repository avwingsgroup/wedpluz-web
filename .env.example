# ---------------------------------------------------------------------------
# Wedpluz web — environment configuration (public, browser-visible values ONLY)
# Never place API secrets, payment secret keys or service credentials here.
# ---------------------------------------------------------------------------

# Which deployable to build: web | admin
VITE_APP_TARGET=web

# Laravel REST API base URL (versioned)
VITE_API_BASE_URL=https://api.wedpluz.com/api/v1

# API mode: live | mock  (mock = typed in-browser fixtures, no backend required)
VITE_API_MODE=mock

# Public origins (used for canonical links, share URLs and cross-app links)
VITE_WEB_ORIGIN=https://wedpluz.com
VITE_ADMIN_ORIGIN=https://admin.wedpluz.com

# Realtime (Laravel Reverb / Pusher-protocol or Socket.IO endpoint). Leave empty to disable.
VITE_REALTIME_URL=
VITE_REALTIME_KEY=

# Third-party PUBLIC keys (publishable only). Payments currently use hosted checkout
# (authorizationUrl from the API), so the payment keys below are reserved for optional inline SDKs.
# Monnify needs no browser key: the backend initialises Monnify transactions server-side.
# Google sign-in. The button uses the backend redirect flow (GET /auth/google/redirect → /auth/google/callback),
# which needs no browser key. Setting the OAuth *web client id* here also enables Google One Tap (live API only).
# Public value; NEVER put the client secret in any VITE_* variable — it belongs only in the backend .env.
VITE_GOOGLE_CLIENT_ID=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYPAL_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
VITE_FIREBASE_CONFIG_JSON=

# SEO: extra sitemaps (backend event/vendor sitemaps) listed in the generated robots.txt, comma separated
VITE_SITEMAP_EXTRA=

# Monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
