{
  "name": "wedpluz-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wedpluz public web application and administrative dashboard (Vue 3 + TypeScript)",
  "scripts": {
    "dev": "vite",
    "dev:admin": "cross-env VITE_APP_TARGET=admin vite --port 5174",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:staging": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode staging",
    "build:admin": "cross-env VITE_APP_TARGET=admin vite build --outDir dist-admin",
    "build:admin:staging": "cross-env VITE_APP_TARGET=admin vite build --mode staging --outDir dist-admin",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "test:coverage": "node scripts/vitest.mjs run --coverage",
    "test:e2e": "playwright test",
    "openapi:validate": "node scripts/validate-openapi.mjs",
    "openapi:examples": "node scripts/openapi/capture-examples.mjs .",
    "openapi:generate": "node scripts/openapi/generate.mjs . && node scripts/validate-openapi.mjs"
  },
  "dependencies": {
    "@sentry/vue": "^11.12.0",
    "@tanstack/vue-query": "^5.107.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.45",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "js-yaml": "^5.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
