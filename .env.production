VITE_APP_TARGET=web
VITE_API_BASE_URL=https://api.wedpluz.com/api/v1
VITE_API_URL=https://api.wedpluz.com/api/v1
VITE_API_MODE=live
VITE_WEB_ORIGIN=https://wedpluz.com
VITE_ADMIN_ORIGIN=https://admin.wedpluz.com
VITE_SENTRY_ENVIRONMENT=production

# Google sign-in: the OAuth web client id (public). The client secret lives only in the backend .env.
VITE_GOOGLE_CLIENT_ID=1040045697950-afq5vg3fbvq0r6vivvkg8929ag27m0gk.apps.googleusercontent.com

# Backend sitemaps for events and vendors (served by the API), listed in robots.txt.
VITE_SITEMAP_EXTRA=https://api.wedpluz.com/sitemaps/events.xml,https://api.wedpluz.com/sitemaps/vendors.xml
